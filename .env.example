# Copy to .env; use absolute, user-owned paths. Never point tests at real data.
SB_DATA_DIR=/absolute/path/to/silverbullet-server-data
SB_SPACE_DIR=/absolute/path/to/the-one-space
SB_HOST_PORT=3000
SB_SPACE_PATH=/notes
SB_BROWSER_ORIGIN=http://localhost:3000
ACP_HOST_PORT=3210
ACP_AGENT_TIMEOUT_MS=300000
# Generate separate random secrets (e.g. openssl rand -hex 32).
ACP_BRIDGE_TOKEN=replace-with-random-hex
MCP_TOKEN=replace-with-another-random-hex
# Create this ACCOUNT API token in SilverBullet's dashboard after initial setup.
# The account must have Write + Runtime API access to the intended space.
SB_API_TOKEN=replace-after-dashboard-setup
# 1 exposes only tools marked read-only; 0 also exposes write tools.
MCP_READ_ONLY=1
